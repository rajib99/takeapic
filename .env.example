# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://takeabic.biz

# Stripe  (dashboard.stripe.com -> Developers -> API keys)
STRIPE_SECRET_KEY=sk_test_...
# From the webhook endpoint you create for https://takeabic.biz/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Lead / booking notification emails via Resend (resend.com). Optional: without it, leads are logged to Vercel logs.
RESEND_API_KEY=
LEADS_TO_EMAIL=bookings@takeabic.biz
LEADS_FROM_EMAIL=Take a pic <bookings@takeabic.biz>

# Vercel Blob (Storage -> Blob store). Only needed locally to run `npm run media:upload`.
BLOB_READ_WRITE_TOKEN=
